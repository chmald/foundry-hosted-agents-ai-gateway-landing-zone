<mxfile host="Electron" version="26.0.0"><diagram id="demo-walkthrough-story" name="Page-1"><mxGraphModel dx="1800" dy="840" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="840" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="topbar" value="" style="rounded=0;fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1800" height="8" as="geometry"/></mxCell><mxCell id="topbar2" value="" style="rounded=0;fillColor=#5C2D91;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="990.0000000000001" y="0" width="810.0" height="8" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Five-step demo story mapped to architecture, identity, tools, scale, and observability&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1720" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Each step has a command or prompt, an expected proof point, and the log table that proves it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1720" height="24" as="geometry"/></mxCell><mxCell id="footer" value="Foundry Hosted Agents + AI Gateway Landing Zone  |  v1.1  |  Icons: Microsoft Azure Architecture Icons (V24)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="810" width="1720" height="20" as="geometry"/></mxCell><mxCell id="l_s" value="Walkthrough (scripts/demo_walkthrough.py sequences S1-S5 with pass/fail checks)" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=14;