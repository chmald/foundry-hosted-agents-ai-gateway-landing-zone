            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "in_progress",
              "completed",
              "cancelled"
            ],
            "title": "Status",
            "default": "open"
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ],
            "title": "Priority"
          },
          "assigned_to": {
            "type": "string",
            "title": "Assigned To"
          },
          "location": {
            "type": "string",
            "title": "Location"
          },
          "items_required": {
            "items": {
              "$ref": "#/components/schemas/ItemRequirement"
            },
            "type": "array",
            "title": "Items Required"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "due_date": {
            "type": "string",
            "format": "date-time",
            "title": "Due Date"
          }
